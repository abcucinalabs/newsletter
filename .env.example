# ── Newsletter identity ─────────────────────────────────────────────────────────
NEWSLETTER_NAME="My Weekly"
NEWSLETTER_TAGLINE="The weekly briefing for your audience"
NEWSLETTER_DESCRIPTION="Curated insights delivered every week."
NEWSLETTER_COLOR="#4f46e5"          # Brand accent color (hex)
NEWSLETTER_LOGO_TEXT="mw"           # 2-char logo abbreviation shown when name is long

# ── Resend ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_NAME="My Weekly"        # Defaults to NEWSLETTER_NAME if unset
RESEND_FROM_EMAIL=hello@example.com

# ── Supabase ────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ── Google Gemini (for AI-generated intros) ─────────────────────────────────────
GEMINI_API_KEY=AIzaxxx
GEMINI_MODEL=gemini-1.5-flash

# ── Security ─────────────────────────────────────────────────────────────────────
UNSUBSCRIBE_SECRET=a-long-random-secret-at-least-32-chars
MANAGE_SECRET=                      # Leave empty for dev (no auth). Set in production.

# ── URLs ────────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:3001      # Full public URL of this app (used in email links)
