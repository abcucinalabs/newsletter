{
  "name": "newsletter-mcp",
  "version": "1.0.0",
  "description": "Self-hosted newsletter platform with a built-in MCP server, so AI agents can write, schedule, and send your newsletter.",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && npm run build:mcp",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "start": "next start --port 3001",
    "start:mcp": "node dist/mcp/index.js",
    "lint": "next lint",
    "setup": "cp -n .env.example .env.local && echo 'Created .env.local \u2014 fill it in, then run: npm run dev'"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@supabase/supabase-js": "^2.46.2",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/handlebars": "^4.0.40",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "newsletter",
    "resend",
    "supabase",
    "ai-agents",
    "model-context-protocol",
    "claude"
  ]
}
